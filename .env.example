# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

#ADMIN_SIGNUP_KEY=

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend URL allowed to call the API
FRONTEND_URL=http://localhost:5173

# AI recommendation integration
AI_API_URL=
AI_API_KEY=

# SMTP / PHPMailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=no-reply@espedresort.com
SMTP_FROM_NAME=ESPED Resort

# Public Google OAuth client ID; the client secret is not used by this flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=your_google_client_secret


# Database Configuration
ADMIN_GOOGLE_LOGIN_EMAIL=